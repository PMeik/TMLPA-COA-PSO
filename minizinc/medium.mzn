% ===== TMLPA - Instancia Mediana =====
% 50 clientes, 10 hubs

int: n_clientes = 50;
int: n_hubs = 10;

array[1..n_clientes, 1..n_hubs] of int: d =
[|  5, 14,  8, 12,  6, 18, 11, 15,  9, 13
 | 13,  6, 11,  5, 10,  7, 14,  8, 12,  9
 |  9, 11,  4, 15,  8, 12,  6, 10, 14,  7
 | 12,  8, 14,  6, 11,  5,  9, 13,  7, 10
 |  7, 10,  9, 13,  4, 11,  8, 12,  6, 15
 | 15,  5, 12,  8, 13,  4, 10,  7, 11,  9
 |  8, 13,  7, 11,  9, 14,  5, 12,  6, 10
 | 11,  9, 15,  7, 12,  6, 13,  4, 10,  8
 |  6, 12,  8, 10,  7, 15,  9, 11,  5, 14
 | 14,  7, 10,  9, 15,  8, 11,  6, 13,  4
 |  9,  5, 12,  6, 11,  8, 14,  7, 10, 13
 | 11, 13,  6, 14,  8, 10,  5,  9, 12,  7
 |  7,  9, 11,  4, 13,  6, 10,  8, 15,  5
 | 12,  6, 15,  9,  7, 11, 13,  5,  8, 10
 |  8, 11,  5, 13,  9,  7, 12, 10,  4, 14
 | 10,  8, 14,  5, 12,  9,  7, 11, 13,  6
 |  5, 12,  9, 11,  6, 14,  8, 13,  7, 10
 | 13,  4, 10,  7, 12,  5, 15,  9, 11,  8
 |  9, 14,  6, 12,  8, 11,  4, 10, 13,  7
 | 11,  7, 13,  4,  9,  8, 12,  6, 10,  5
 |  6, 10,  8, 14,  5, 12,  9, 11,  4, 13
 | 14,  5, 11,  8, 13,  4, 10,  7, 12,  9
 |  8, 12,  6, 10,  7, 13,  5,  9, 11,  4
 | 10,  8, 13,  6, 11,  5,  9, 12,  7, 14
 |  7, 11,  9, 13,  4, 10,  8, 14,  5, 12
 | 15,  6, 12,  9, 14,  5, 11,  7, 13,  8
 |  9, 13,  5, 11,  8, 12,  6, 10, 14,  7
 | 12,  7, 14,  5, 10,  8, 13,  6,  9, 11
 |  6, 11,  8, 13,  5, 14,  9, 12,  7, 10
 | 13,  5, 10,  8, 12,  4, 15,  7, 11,  9
 |  8, 12,  7, 10,  9, 13,  4, 11,  6, 14
 | 11,  8, 14,  6, 12,  7, 13,  5, 10,  9
 |  5, 10,  9, 12,  6, 15,  8, 13,  4, 11
 | 14,  6, 11,  7, 13,  5, 12,  8, 10,  9
 |  9, 12,  4, 14,  8, 11,  6, 10, 13,  7
 | 12,  7, 13,  5, 10,  8, 14,  6, 11,  4
 |  7, 11,  8, 13,  4, 10,  9, 12,  5, 15
 | 13,  5, 12,  8, 14,  4, 10,  7, 11,  9
 |  8, 14,  6, 11,  9, 12,  5, 13,  7, 10
 | 10,  8, 13,  6, 12,  5,  9, 11,  4, 14
 |  6, 11,  9, 13,  5, 14,  8, 12,  7, 10
 | 14,  5, 11,  7, 12,  4, 10,  8, 13,  6
 |  9, 12,  5, 10,  8, 13,  6, 11, 14,  4
 | 11,  7, 14,  5, 10,  8, 12,  6,  9, 13
 |  7, 10,  8, 12,  4, 11,  9, 13,  5, 14
 | 13,  6, 11,  8, 14,  5, 12,  7, 10,  9
 |  8, 13,  6, 11,  9, 12,  4, 14,  7, 10
 | 11,  8, 14,  6, 12,  7, 13,  4, 10,  9
 |  5, 10,  9, 13,  6, 14,  8, 12,  4, 11
 | 12,  7, 11,  5, 10,  8, 13,  6,  9,  4 |];

array[1..n_hubs] of int: f = [45, 50, 40, 55, 35, 60, 38, 52, 42, 48];
array[1..n_hubs] of float: o = [1.5, 1.8, 1.2, 1.9, 1.1, 2.0, 1.3, 1.7, 1.4, 1.6];
array[1..n_hubs] of int: L = [30, 35, 25, 40, 20, 45, 25, 35, 20, 20];

array[1..n_clientes] of int: q = [3, 2, 4, 3, 2, 5, 3, 2, 4, 1, 3, 2, 4, 3, 2, 5, 3, 2, 4, 1, 3, 2, 4, 3, 2, 5, 3, 2, 4, 1, 3, 2, 4, 3, 2, 5, 3, 2, 4, 1, 3, 2, 4, 3, 2, 5, 3, 2, 4, 1];

array[1..n_clientes] of float: w = [1.0, 1.2, 1.5, 1.0, 0.8, 1.1, 1.3, 0.9, 1.0, 1.4, 0.9, 1.1, 1.2, 1.0, 0.8, 1.5, 1.1, 1.0, 1.3, 0.9, 1.2, 1.0, 1.4, 0.8, 1.1, 1.0, 1.3, 1.5, 0.9, 1.2, 1.1, 0.8, 1.0, 1.4, 1.2, 1.3, 0.9, 1.1, 1.0, 1.5, 0.8, 1.2, 1.1, 1.4, 1.0, 1.3, 0.9, 1.2, 1.0, 1.5];

int: d_max = 15;
int: P = 6;
int: P_min = 2;

array[1..n_clientes] of var 1..n_hubs: x;
array[1..n_hubs] of var 0..1: y;

constraint forall(c in 1..n_clientes)( y[x[c]] = 1 );
constraint forall(j in 1..n_hubs)( sum(c in 1..n_clientes where x[c] = j)(q[c]) <= L[j] );
constraint forall(c in 1..n_clientes)( d[c, x[c]] <= d_max );
constraint P_min <= sum(j in 1..n_hubs)(y[j]) /\ sum(j in 1..n_hubs)(y[j]) <= P;

var float: costo_instalacion = sum(j in 1..n_hubs)( f[j] * y[j] + o[j] * sum(c in 1..n_clientes where x[c] = j)(q[c]) );
var float: costo_caminata = sum(c in 1..n_clientes)( w[c] * d[c, x[c]] );
var float: fo = costo_instalacion + costo_caminata;

solve minimize fo;

output [
    "y (hubs) = ", show(y), "\n",
    "FO optima = ", show(fo), "\n"
];
